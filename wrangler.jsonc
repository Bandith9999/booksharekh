{
	"name": "booksharekh-ai-manager",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "booksharekh-ai-db",
			"database_id": "b53158e2-465c-4324-b395-c90bb1a46300",
			"migrations_dir": "migrations"
		}
	],
	// Create both queues once before deploying:
	//   npx wrangler queues create booksharekh-tasks
	//   npx wrangler queues create booksharekh-tasks-dlq
	// Every 15 minutes: announce new book requests from booksharekh.com (Workers Free includes cron triggers).
	"triggers": { "crons": ["*/2 * * * *"] },
	"queues": {
		"producers": [{ "binding": "TASK_QUEUE", "queue": "booksharekh-tasks" }],
		"consumers": [
			{
				"queue": "booksharekh-tasks",
				"max_batch_size": 5,
				"max_batch_timeout": 2,
				"max_retries": 5,
				"dead_letter_queue": "booksharekh-tasks-dlq"
			},
			{ "queue": "booksharekh-tasks-dlq", "max_batch_size": 10, "max_retries": 2 }
		]
	},
	"vars": {
		"OWNER_TELEGRAM_ID": "802529780",
		"GITHUB_OWNER": "Bandith9999",
		"GITHUB_REPO": "booksharekh",

		// Website management. WEBSITE_REPO = the PRIVATE Laravel repository name (empty until it exists).
		// LARAVEL_API_URL = base URL of the restricted AI API (empty until installed); its token is the
		// secret LARAVEL_API_TOKEN.
		// Telegram messages: "km" = short Khmer (commands and technical words stay English); "en" = English.
		"BOT_LANGUAGE": "km",
		// Promo video voice-over: Gemini text-to-speech with the secret GEMINI_API_KEY (Google AI Studio).
		// Voice: one of Google's prebuilt voices (Sulafat = warm, Achird = friendly, Kore = firm, Aoede = breezy, …).
		// If Gemini is unavailable, the video uses edge-tts (km-KH-SreymomNeural), or no voice.
		"PROMO_TTS_VOICE": "Sulafat",
		"PROMO_TTS_MODEL": "gemini-3.8-flash-tts",
		"WEBSITE_URL": "https://booksharekh.com",
		// Book searches return only editions in these languages (2-letter codes).
		"BOOK_LANGUAGES": "en",
		"WEBSITE_REPO": "booksharekh-website",
		"LARAVEL_API_URL": "https://booksharekh.com",

		// Planning AI: Claude Sonnet 5.5 via the Anthropic API (owner decision 2026-11-22, ~ $0.01 per plan).
		// Key: Cloudflare secret ANTHROPIC_API_KEY. Every tier inherits this default.
		// $0 alternative (README section I): AI_DEFAULT_PROVIDER=google, AI_DEFAULT_MODEL=gemini-3.8-flash,
		// AI_PAID_ENABLED=false, empty AI_DEFAULT_CHAIN / AI_REVIEW_CHAIN, plus the secret GEMINI_API_KEY.
		"AI_DEFAULT_PROVIDER": "anthropic",
		"AI_DEFAULT_MODEL": "claude-sonnet-5-5",
		// QA Reviewer (second opinion on marketing text): Gemini, secret GEMINI_API_KEY. Never gets private code.
		"AI_REVIEW_PROVIDER": "google",
		"AI_REVIEW_MODEL": "gemini-3.8-flash",

		// AI team (owner request 2026-11-23): who does each job first, and who takes over at a limit.
		// An AI at its limit rests until it resets (Gemini: midnight Pacific; rate limits: as the provider
		// says; no credit / bad key: 6 h) and the next one continues. If all rest, the task resumes itself.
		// openai:auto = the newest GPT "Sol" model this key can use (Codex family), found automatically.
		// Writing, planning, Khmer copy: Claude → Codex → Gemini.
		"AI_DEFAULT_CHAIN": "anthropic:claude-sonnet-5-5,openai:auto,google:gemini-3.8-flash",
		// Teamwork (owner request 2026-11-24) for plans, posters and videos: the first AI in the chain writes,
		// the other AIs review in parallel and suggest improvements, then the writer makes the final version.
		// About 2-3 extra AI calls per job. "false" = the old way (one AI, others only take over at a limit).
		"AI_TEAMWORK": "true",
		// QA second opinion: Gemini → Codex → Claude (and never the AI that wrote the work).
		"AI_REVIEW_CHAIN": "google:gemini-3.8-flash,openai:auto,anthropic:claude-sonnet-5-5",

		// Paid AI lock. "true" = unlocked by the owner for Claude. When "false", only the free Gemini models
		// below (and mock) can run. Only the owner should change this.
		"AI_PAID_ENABLED": "true",
		"AI_FREE_MODELS": "gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite",
		// json_schema (default) | openapi | prompt. Switch if Gemini rejects the schema field; output is
		// validated in the Worker in every mode.
		"GEMINI_SCHEMA_MODE": "json_schema",

		// Old single-AI fallback (only used when a job has no chain above). The AI chains handle switching.
		"AI_FALLBACK_ENABLED": "false",

		// Spending cap. 100,000 tokens/day on Claude Sonnet 5.5 is at most about $1/day even if every token
		// were output ($10 per million). Daily limits pause tasks; per-minute limits retry later.
		// Also set a monthly limit in the Claude Console (Plans & Billing) as a second guard.
		"AI_MAX_REQUESTS_PER_MINUTE": "5",
		"AI_MAX_REQUESTS_PER_DAY": "60",
		"DAILY_TASK_LIMIT": "150",
		"RECOMMEND_EVERY_DAYS": "3",
		"TASK_RATE_LIMIT_PER_HOUR": "10",
		"TASK_TOKEN_BUDGET": "20000",
		"DAILY_TOKEN_BUDGET": "100000",
		"APPROVAL_TTL_HOURS": "24"
	}
}
