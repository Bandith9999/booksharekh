{
	"name": "booksharekh-ai-manager",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "booksharekh-ai-db",
			"database_id": "b53158e2-465c-4324-b395-c90bb1a46300",
			"migrations_dir": "migrations"
		}
	],
	// Create both queues once before deploying:
	//   npx wrangler queues create booksharekh-tasks
	//   npx wrangler queues create booksharekh-tasks-dlq
	"queues": {
		"producers": [{ "binding": "TASK_QUEUE", "queue": "booksharekh-tasks" }],
		"consumers": [
			{
				"queue": "booksharekh-tasks",
				"max_batch_size": 5,
				"max_batch_timeout": 2,
				"max_retries": 5,
				"dead_letter_queue": "booksharekh-tasks-dlq"
			},
			{ "queue": "booksharekh-tasks-dlq", "max_batch_size": 10, "max_retries": 2 }
		]
	},
	"vars": {
		"OWNER_TELEGRAM_ID": "802529780",
		"GITHUB_OWNER": "Bandith9999",
		"GITHUB_REPO": "booksharekh",

		// Website management. WEBSITE_REPO = the PRIVATE Laravel repository name (empty until it exists).
		// LARAVEL_API_URL = base URL of the restricted AI API (empty until installed); its token is the
		// secret LARAVEL_API_TOKEN.
		"WEBSITE_URL": "https://booksharekh.com",
		"WEBSITE_REPO": "",
		"LARAVEL_API_URL": "",

		// $0 mode: every agent uses the default tier, Gemini on Google's free API tier.
		// The other tiers (AI_FAST_*, AI_REVIEW_*, AI_CODE_*) are unset, so they inherit the default.
		// Override one agent from Telegram with /agent <name> set provider=google model=<free model>.
		// Keys are Cloudflare secrets, never vars: GEMINI_API_KEY (from a Google project WITHOUT billing).
		"AI_DEFAULT_PROVIDER": "google",
		"AI_DEFAULT_MODEL": "gemini-3.8-flash",

		// Paid AI lock. While "false", only these free Gemini models (and the mock provider) can run;
		// Anthropic, OpenAI and non-free Gemini models are refused. Only the owner should change this.
		"AI_PAID_ENABLED": "false",
		"AI_FREE_MODELS": "gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite",
		// json_schema (default) | openapi | prompt. Switch if Gemini rejects the schema field; output is
		// validated in the Worker in every mode.
		"GEMINI_SCHEMA_MODE": "json_schema",

		// Runtime provider fallback is off (and a paid fallback is refused while paid AI is locked).
		"AI_FALLBACK_ENABLED": "false",

		// Free-tier limits. Keep them BELOW the RPM/RPD shown for your project in AI Studio
		// (https://aistudio.google.com/rate-limit). Daily limits pause tasks; per-minute limits retry later.
		"AI_MAX_REQUESTS_PER_MINUTE": "5",
		"AI_MAX_REQUESTS_PER_DAY": "100",
		"DAILY_TASK_LIMIT": "20",
		"TASK_RATE_LIMIT_PER_HOUR": "10",
		"TASK_TOKEN_BUDGET": "30000",
		"DAILY_TOKEN_BUDGET": "300000",
		"APPROVAL_TTL_HOURS": "24"
	}
}
