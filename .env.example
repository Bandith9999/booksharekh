# These are placeholders only. Use `npx wrangler secret put NAME` in production.
# Non-secret settings (providers, models, budgets) live in wrangler.jsonc "vars".
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GITHUB_TOKEN=
JOB_CALLBACK_SECRET=
# $0 mode needs only GEMINI_API_KEY (AI Studio key from a project with no billing linked).
# Paid providers below are refused unless AI_PAID_ENABLED=true in wrangler.jsonc.
ANTHROPIC_API_KEY=
# OpenAI (paid, locked by default) and Gemini (the $0 default):
OPENAI_API_KEY=
GEMINI_API_KEY=
